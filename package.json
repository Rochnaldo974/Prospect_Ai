{
  "name": "prospect-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @prospect/web dev",
    "dev:worker": "pnpm --filter @prospect/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff -f",
    "db:types": "supabase gen types typescript --local > packages/core/src/db/database.types.ts",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "show:opportunities": "node --import tsx scripts/show-opportunities.mjs",
    "seed:dev": "node scripts/seed-dev.mjs",
    "seed:companies": "node scripts/seed-companies.mjs",
    "ingest:csv": "node --import tsx scripts/ingest-csv.mjs",
    "discover": "node --import tsx scripts/discover.mjs",
    "scan:domains": "node --import tsx scripts/scan-domains.mjs",
    "import:afnic": "node --import tsx scripts/import-afnic.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "@supabase/supabase-js": "^2.112.4",
    "zod": "^4.4.3",
    "tsx": "^4.23.12",
    "@prospect/core": "workspace:*"
  }
}
