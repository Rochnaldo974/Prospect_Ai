# Projet Supabase hébergé — Prospect-Ai
#
# Référence  tjeqsghmlwxmedumsdyt
# Région     eu-west-3 (Paris) — au plus près des entreprises visées et des
#            utilisateurs, et le cadre le plus simple côté RGPD.
#
# Copier ce fichier en .env.production et compléter les deux valeurs secrètes.
# Elles se trouvent dans le tableau de bord Supabase, Settings → API et
# Settings → Database. Elles ne sont JAMAIS versionnées.

NEXT_PUBLIC_SUPABASE_URL=https://tjeqsghmlwxmedumsdyt.supabase.co

# Clé publiable : destinée au navigateur, elle ne donne accès qu'à ce que les
# policies RLS autorisent pour un utilisateur connecté.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_gQawyn1T0WcoSwMQ3FZDHw_mLVY5ppb

# Clé de service : contourne toute la RLS. Elle ne doit exister que côté
# serveur — le module apps/web/lib/supabase/admin.ts est la seule porte
# d'entrée, et `server-only` fait échouer le build si elle approche du client.
SUPABASE_SERVICE_ROLE_KEY=

# Connexion directe, pour le worker et les migrations.
# Settings → Database → Connection string. Le mot de passe y est inclus.
DATABASE_URL=

WORKER_ID=worker-prod-1
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=5000
LOG_LEVEL=info
