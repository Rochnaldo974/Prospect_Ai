# ─── Supabase ────────────────────────────────────────────────────────────────
# Valeurs locales par défaut (affichées par `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Serveur uniquement — ne JAMAIS exposer côté client, ne JAMAIS préfixer NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ─── Worker ──────────────────────────────────────────────────────────────────
WORKER_ID=local
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=2000

# ─── Sources de données ──────────────────────────────────────────────────────
SIRENE_API_KEY=
POI_API_KEY=

# ─── IA (phase 15) ───────────────────────────────────────────────────────────
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Connexion Google ────────────────────────────────────────────────────────
# ATTENTION : ces deux clés ne vont PAS dans .env.local.
#
# .env.local est le fichier de Next.js ; le CLI Supabase ne le lit jamais.
# C'est lui qui résout les env(...) de supabase/config.toml, au démarrage,
# depuis un fichier « .env » à la racine. Un secret posé dans .env.local
# laisse donc le fournisseur désactivé sans le moindre message d'erreur —
# l'API répond « provider is not enabled » et rien n'explique pourquoi.
#
# Copiez-les dans un fichier « .env » à la racine (déjà gitignoré), puis
# relancez « supabase stop && supabase start » : la configuration est lue
# une seule fois, au démarrage des conteneurs.
#
# Le client ID n'est pas un secret. Le secret, si.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
