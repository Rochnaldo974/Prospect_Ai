# ─── Supabase ────────────────────────────────────────────────────────────────
# Valeurs locales par défaut (affichées par `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Serveur uniquement — ne JAMAIS exposer côté client, ne JAMAIS préfixer NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ─── Worker ──────────────────────────────────────────────────────────────────
WORKER_ID=local
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=2000

# ─── Sources de données ──────────────────────────────────────────────────────
SIRENE_API_KEY=
POI_API_KEY=

# ─── IA (phase 15) ───────────────────────────────────────────────────────────
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
