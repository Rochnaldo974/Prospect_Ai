# ─── Supabase ────────────────────────────────────────────────────────────────
# Valeurs locales par défaut (affichées par `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Serveur uniquement — ne JAMAIS exposer côté client, ne JAMAIS préfixer NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ─── Worker ──────────────────────────────────────────────────────────────────
WORKER_ID=local
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=2000

# ─── Sources de données ──────────────────────────────────────────────────────
SIRENE_API_KEY=
POI_API_KEY=

# ─── IA (phase 15) ───────────────────────────────────────────────────────────
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Connexion Google ────────────────────────────────────────────────────────
# ATTENTION : ces deux clés ne vont PAS dans .env.local.
#
# .env.local est le fichier de Next.js ; le CLI Supabase ne le lit jamais.
# C'est lui qui résout les env(...) de supabase/config.toml, au démarrage,
# depuis un fichier « .env » à la racine. Un secret posé dans .env.local
# laisse donc le fournisseur désactivé sans le moindre message d'erreur —
# l'API répond « provider is not enabled » et rien n'explique pourquoi.
#
# Copiez-les dans un fichier « .env » à la racine (déjà gitignoré), puis
# relancez « supabase stop && supabase start » : la configuration est lue
# une seule fois, au démarrage des conteneurs.
#
# Le client ID n'est pas un secret. Le secret, si.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# ── Envoi d'e-mails de prospection ──────────────────────────────────────────
# En développement, RIEN à configurer : tout part vers le Mailpit de
# Supabase (127.0.0.1:54325) et se lit sur http://127.0.0.1:54324.
#
# En production : le fournisseur SMTP (Resend, Postmark, OVH…). Le « De »
# est EMAIL_FROM — une adresse du domaine du service, authentifiée SPF/DKIM
# chez le fournisseur — avec le nom de l'utilisateur en étiquette ; le
# « Répondre à » est l'adresse du compte de l'utilisateur : les réponses
# vont au freelance, jamais à nous.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
